{
  "name": "@eghrhegpe/dsh-connect-qoder",
  "displayName": "DSH Connect Qoder",
  "description": "将本机已登录的 Qoder（国内版 Qoder CN / 国际版 Qoder）模型接入 DeepSeek Harness —— bring locally signed-in Qoder models into DeepSeek Harness with zero configuration.",
  "version": "0.4.1",
  "author": "eghrhegpe",
  "homepage": "https://github.com/eghrhegpe/dsh-connect-qoder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eghrhegpe/dsh-connect-qoder.git"
  },
  "bugs": {
    "url": "https://github.com/eghrhegpe/dsh-connect-qoder/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "qoder",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=68 --test-coverage-branches=85 --test-coverage-functions=66 \"test/*.test.js\"",
    "verify": "npm test && node scripts/build-client.mjs --tsdown && npm run verify:bundle",
    "verify:deploy": "node scripts/check-deploy-drift.mjs",
    "verify:bundle": "node scripts/verify-bundle-behaviour.mjs",
    "build": "node scripts/build-client.mjs --tsdown --write",
    "prepack": "npm run build"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "tsdown": "^0.23.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5 <0.2",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.5 <0.2",
    "@deepseek-ai/dsh-settings": ">=0.1.5 <0.2",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5 <0.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5 <0.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5 <0.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5 <0.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5 <0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^0.85.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
