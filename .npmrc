# The peer dependencies this plugin declares are the harness's own packages
# (`@deepseek-ai/*`). They are supplied by the running DSH install, not by a
# registry — and they are not on the public one. npm 7+ tries to install peers
# automatically, so a plain `npm install` fails with ENOTARGET before it ever
# reaches the devDependencies.
#
# `legacy-peer-deps` skips that automatic install, which is what we want: the
# peer contract is checked by the host at load time, not by npm at install
# time. Without this file `npm install` cannot set up a build at all.
legacy-peer-deps=true
